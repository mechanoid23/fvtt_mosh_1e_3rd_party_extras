{"_id":"GfsContracts001","name":"Gear For A Spacefarer - Contracts","description":"","formula":"1d10","replacement":true,"displayRoll":true,"folder":null,"sort":0,"results":[{"_id":"GfsContract010","type":0,"text":"Assassinate the CEO of The Cadwal Trade Depot.","img":"icons/svg/d10-grey.svg","documentCollection":"","documentId":"","weight":1,"range":[1,1],"drawn":false},{"_id":"GfsContract020","type":0,"text":"Dismantle the failed colony ship Utah under the CTD scavenging rights.","img":"icons/svg/d10-grey.svg","documentCollection":"","documentId":"","weight":1,"range":[2,2],"drawn":false},{"_id":"GfsContract030","type":0,"text":"Intercept and destroy a shipment of ore from Tengliu 3.","img":"icons/svg/d10-grey.svg","documentCollection":"","documentId":"","weight":1,"range":[3,3],"drawn":false},{"_id":"GfsContract040","type":0,"text":"Locate the CTD Isabella after it stopped transmitting signal to the rest of the fleet in the Rose Asteroid Belt.","img":"icons/svg/d10-grey.svg","documentCollection":"","documentId":"","weight":1,"range":[4,4],"drawn":false},{"_id":"GfsContract050","type":0,"text":"Muling heavily illegal cybermods to a group of marines fighting in Blackstar Lushworld War in the outer rims.","img":"icons/svg/d10-grey.svg","documentCollection":"","documentId":"","weight":1,"range":[5,5],"drawn":false},{"_id":"GfsContract060","type":0,"text":"Perform repo enforcement for a portable gravity generator the Lucille let a local colony borrow.","img":"icons/svg/d10-grey.svg","documentCollection":"","documentId":"","weight":1,"range":[6,6],"drawn":false},{"_id":"GfsContract070","type":0,"text":"Pick up a shipment of wheat from the agrarian station Within Wheels and deliver it back to The Lucille when it is near Alexandria 3.","img":"icons/svg/d10-grey.svg","documentCollection":"","documentId":"","weight":1,"range":[7,7],"drawn":false},{"_id":"GfsContract080","type":0,"text":"Quickly transport a tanker full of vat grown blood as far away from the station as possible.","img":"icons/svg/d10-grey.svg","documentCollection":"","documentId":"","weight":1,"range":[8,8],"drawn":false},{"_id":"GfsContract090","type":0,"text":"Ship a container to Tsade 4. Under no circumstances are you allowed to open the container.","img":"icons/svg/d10-grey.svg","documentCollection":"","documentId":"","weight":1,"range":[9,9],"drawn":false},{"_id":"GfsContract100","type":0,"text":"\"Delouse\" and disinfect a shipment of algae coming in from Mokosh 3.","img":"icons/svg/d10-grey.svg","documentCollection":"","documentId":"","weight":1,"range":[10,10],"drawn":false}],"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1685936572185,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}

{"_id":"DcsJournalEntry1","name":"Disciples of a Cracked Skull","pages":[{"_id":"DcsJournalPage01","name":"Weapons","type":"text","title":{"show":true,"level":1},"text":{"format":1,"content":"<table><thead><tr><th></th><th>NAME</th><th>COST</th><th>RANGE</th><th>DAMAGE</th><th>SHOTS</th><th>CRITICAL</th><th>SPECIAL</th></tr></thead><tbody><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_chainsaw.png\"></p></td><td>Chainsaw</td><td>350cr</td><td>Close</td><td>1 Wound</td><td>N/A</td><td>Gore/Massive</td><td></td></tr><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_molotov-cocktail.png\"></p></td><td>Molotov Cocktail</td><td>10cr</td><td>Nearby</td><td>2d10</td><td>1</td><td>Fire/Explosion</td><td>All Nearby must Body Save to avoid.</td></tr><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_chem-sprayer.png\"></p></td><td>Chem Sprayer</td><td>125cr</td><td>Nearby</td><td>4d10</td><td>4</td><td>Chemical Weapons</td><td>All Nearby must Body Save to avoid.</td></tr><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_lasso.png\"></p></td><td>Lasso</td><td>30cr</td><td>Nearby</td><td>1</td><td>N/A</td><td>Blunt Force</td><td>Body Save or become stuck. Strength[-] Check to escape. Crit chokes target.</td></tr><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_rioters-shield.png\"></p></td><td>Rioter's Shield</td><td>300cr</td><td>Close</td><td>1d5</td><td>N/A</td><td>Blunt Force</td><td>Provides +5 AP.</td></tr><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_warp-core-grenade.png\"></p></td><td>Warp Core Grenade</td><td>2kcr</td><td>Nearby</td><td>1d10 Wounds</td><td>1</td><td>Fire/Explosion</td><td>The area surrounding the explosion is irradiated to Level 3 for a week.</td></tr><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_pressure-bomb.png\"></p></td><td>Pressure Bomb</td><td>100cr</td><td>Nearby</td><td>1d10</td><td>1</td><td>Bleeding</td><td>All Nearby must Body Save to avoid.</td></tr><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_beartrap.png\"></p></td><td>Beartrap</td><td>240cr</td><td>Close</td><td>2d10</td><td>1</td><td>Blunt Force</td><td>Body Save or become stuck. Strength[-] Check to escape. Any Wound affects the leg.</td></tr><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_stink-bomb.png\"></p></td><td>Stink Bomb</td><td>40cr</td><td>Nearby</td><td>1</td><td>1</td><td>Chemical Weapons</td><td>All Nearby must Body Save to avoid coughing until the cloud dissipates.</td></tr><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_ice-pick.png\"></p></td><td>Ice Pick</td><td>150cr</td><td>Close</td><td>1d10</td><td>N/A</td><td>Bleeding</td><td>Naturally Armor Piercing.</td></tr><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_slungshot.png\"></p></td><td>Slungshot</td><td>5cr</td><td>Close</td><td>1d5</td><td>N/A</td><td>Blunt Force</td><td></td></tr><tr><td><p><img src=\"modules/fvtt_mosh_1e_3rd_party_extras/images/weapon_firework-launcher.png\"></p></td><td>Firework Launcher</td><td>120cr</td><td>Far Away</td><td>1 Wound</td><td>1</td><td>Fire/Explosion</td><td>All Far Away must Body Save to avoid.</td></tr></tbody></table>"},"sort":0,"ownership":{"default":-1},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1685936572185,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}],"folder":null,"sort":0,"ownership":{"default":0},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1685936572185,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
